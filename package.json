{
  "name": "zaal-planner",
  "productName": "Zaal Planner",
  "description": "Administratie voor zaalplanning in de vereniging",
  "private": true,
  "version": "0.0.16",
  "type": "module",
  "main": ".vite/build/main.js",
  "author": {
    "name": "Joris Timmermans",
    "email": "jhm.timmermans@ziggo.nl"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "start": "electron-forge start",
    "package": "vite build && electron-forge package",
    "premake": "pnpm version patch --no-git-tag-version",
    "make": "vite build && electron-forge make",
    "publish": "electron-forge publish",
    "db:push": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/drizzle-kit/bin.cjs migrate"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/plugin-vite": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "electron": "^36.2.1",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "better-sqlite3": "^12.5.0",
    "bits-ui": "^2.14.4",
    "drizzle-orm": "^0.44.7",
    "electron-squirrel-startup": "^1.0.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "sweetalert2": "^11.26.21"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller"
    ]
  }
}
